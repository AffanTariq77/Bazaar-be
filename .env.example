DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bazaar_dev?schema=public"

JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

PORT=3000
CORS_ORIGIN=http://localhost:5173

# Set to true only when this app is served over HTTPS — a Secure refresh
# cookie is silently dropped by the browser over plain HTTP.
COOKIE_SECURE=false
