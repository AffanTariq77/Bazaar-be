# @nestjs/throttler's latest release only declares peer support up to Nest 11
# in package.json, even though it works correctly against this Nest 12 app
# (verified: rate limiting behaves correctly at runtime). Without this, a
# plain `npm ci` — used here and in the Docker build — fails on the peer
# conflict even though package-lock.json already reflects a resolved tree.
legacy-peer-deps=true
